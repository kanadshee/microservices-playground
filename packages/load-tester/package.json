{
  "name": "load-tester",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test:cli": "tsx src/cli.ts",
    "test:light": "tsx src/cli.ts --rps 10 --duration 30 --pattern normal",
    "test:medium": "tsx src/cli.ts --rps 50 --duration 60 --pattern mixed",
    "test:heavy": "tsx src/cli.ts --rps 150 --duration 60 --pattern burst"
  },
  "dependencies": {
    "@micro/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
